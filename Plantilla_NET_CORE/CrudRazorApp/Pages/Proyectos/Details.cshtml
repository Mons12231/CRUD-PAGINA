@page
@model CrudRazorApp.Pages.Proyectos.DetailsModel
@{
    ViewData["Title"] = "Detalles del Proyecto";
}

<link rel="stylesheet" href="~/css/IndexProyectos.css" />

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h2 class="mb-0">📋 Detalles del Proyecto</h2>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Categoría:</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-primary">@Model.Proyecto.Categoria</span>
                        </dd>

                        <dt class="col-sm-4">Nombre del Proyecto:</dt>
                        <dd class="col-sm-8">
                            <strong>@Model.Proyecto.NombreProyecto</strong>
                        </dd>

                        <dt class="col-sm-4">Fecha de Inicio:</dt>
                        <dd class="col-sm-8">@Model.Proyecto.FechaInicio.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Fecha de Finalización:</dt>
                        <dd class="col-sm-8">@Model.Proyecto.FechaFinalizacion.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Integrante(s):</dt>
                        <dd class="col-sm-8">@Model.Proyecto.Integrante</dd>

                        <dt class="col-sm-4">Tareas:</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Proyecto.Tareas))
                            {
                                <div class="border p-3 bg-light rounded">
                                    @Model.Proyecto.Tareas
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">Sin tareas asignadas</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Fecha de Creación:</dt>
                        <dd class="col-sm-8">
                            <small class="text-muted">@Model.Proyecto.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
                        </dd>

                        <dt class="col-sm-4">Última Modificación:</dt>
                        <dd class="col-sm-8">
                            <small class="text-muted">@Model.Proyecto.FechaModificacion.ToString("dd/MM/yyyy HH:mm")</small>
                        </dd>
                    </dl>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-page="Index" class="btn btn-secondary">
                            ← Volver a la lista
                        </a>
                        <div>
                            <a asp-page="Edit" asp-route-id="@Model.Proyecto.ProyectoId" class="btn btn-warning">
                                ✏️ Editar
                            </a>
                            <a asp-page="Delete" asp-route-id="@Model.Proyecto.ProyectoId" class="btn btn-danger">
                                🗑️ Eliminar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

