@page
@model CrudRazorApp.Pages.Proyectos.IndexModel
@{
    ViewData["Title"] = "Proyectos";
}
<link rel="stylesheet" href="~/css/IndexProyectos.css" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Gestor de Proyectos</h1>
    <div>
        <a class="btn btn-primary me-2" asp-page="/Tareas/Index">
            <i class="bi bi-list-check"></i> Ver Tareas
        </a>
        <a class="btn btn-success" asp-page="Create">➕ Nuevo Proyecto</a>
    </div>
</div>

<table class="table table-striped table-hover">
    <thead class="table-light">
        <tr>
            <th>Categoría</th>
            <th>Nombre del Proyecto</th>
            <th>Fecha de Inicio</th>
            <th>Fecha de Finalización</th>
            <th>Integrante</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ListaProyectos != null && Model.ListaProyectos.Any())
        {
            @foreach (var proyecto in Model.ListaProyectos)
            {
                <tr>
                    <td>
                        <span class="badge bg-primary">@proyecto.Categoria</span>
                    </td>
                    <td>
                        <strong>@proyecto.NombreProyecto</strong>
                    </td>
                    <td>@proyecto.FechaInicio.ToString("dd/MM/yyyy")</td>
                    <td>@proyecto.FechaFinalizacion.ToString("dd/MM/yyyy")</td>
                    <td>@proyecto.Integrante</td>
                    <td class="text-end">
                        <a asp-page="Details" asp-route-id="@proyecto.ProyectoId" class="btn btn-info btn-sm" title="Ver detalles">
                            <i class="bi bi-eye"></i> Detalles
                        </a>
                        <a asp-page="Edit" asp-route-id="@proyecto.ProyectoId" class="btn btn-warning btn-sm" title="Editar">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        <a asp-page="Delete" asp-route-id="@proyecto.ProyectoId" class="btn btn-danger btn-sm" title="Eliminar">
                            <i class="bi bi-trash"></i> Eliminar
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-5">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p class="mt-3">No hay proyectos registrados</p>
                    <a asp-page="Create" class="btn btn-success mt-2">
                        ➕ Crear primer proyecto
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.ListaProyectos != null && Model.ListaProyectos.Any())
{
    <div class="mt-3">
        <p class="text-muted">
            <strong>Total de proyectos:</strong> @Model.ListaProyectos.Count
        </p>
    </div>
}