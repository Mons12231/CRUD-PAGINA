@page
@model CrudRazorApp.Pages.Tareas.DetailsModel
@{
    ViewData["Title"] = "Detalles de la Tarea";
}
<link rel="stylesheet" href="~/css/IndexTareas.css" />

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h2 class="mb-0">📋 Detalles de la Tarea</h2>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Proyecto:</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary fs-6">@Model.Tarea.Proyecto?.NombreProyecto</span>
                        </dd>

                        <dt class="col-sm-4">Nombre de la Tarea:</dt>
                        <dd class="col-sm-8"><strong>@Model.Tarea.NombreTarea</strong></dd>

                        <dt class="col-sm-4">Fecha de Inicio:</dt>
                        <dd class="col-sm-8">@Model.Tarea.FechaInicio.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Fecha de Finalización:</dt>
                        <dd class="col-sm-8">@Model.Tarea.FechaFinalizacion.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Integrantes:</dt>
                        <dd class="col-sm-8">@Model.Tarea.Integrantes</dd>

                        <dt class="col-sm-4">Estatus:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Tarea.Estatus == "Completada")
                            {
                                <span class="badge bg-success fs-6">✓ @Model.Tarea.Estatus</span>
                            }
                            else if (Model.Tarea.Estatus == "En Progreso")
                            {
                                <span class="badge bg-warning text-dark fs-6">⏳ @Model.Tarea.Estatus</span>
                            }
                            else
                            {
                                <span class="badge bg-info fs-6">@Model.Tarea.Estatus</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Descripción:</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Tarea.Descripcion))
                            {
                                <div class="border p-3 bg-light rounded">@Model.Tarea.Descripcion</div>
                            }
                            else
                            {
                                <span class="text-muted">Sin descripción</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Acciones:</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Tarea.Acciones))
                            {
                                <div class="border p-3 bg-light rounded">@Model.Tarea.Acciones</div>
                            }
                            else
                            {
                                <span class="text-muted">Sin acciones</span>
                            }
                        </dd>
                    </dl>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-page="Index" class="btn btn-secondary">← Volver</a>
                        <div>
                            <a asp-page="Edit" asp-route-id="@Model.Tarea.TareaId" class="btn btn-warning">✏️ Editar</a>
                            <a asp-page="Delete" asp-route-id="@Model.Tarea.TareaId" class="btn btn-danger">🗑️ Eliminar</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>