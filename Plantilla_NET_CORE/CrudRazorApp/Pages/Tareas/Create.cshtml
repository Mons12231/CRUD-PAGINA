@page
@model CrudRazorApp.Pages.Tareas.CreateModel
@{
    ViewData["Title"] = "Crear Tarea";
}
<link rel="stylesheet" href="~/css/IndexTareas.css" />

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h2 class="mb-0">➕ Crear Nueva Tarea</h2>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Tarea.ProyectoId" class="form-label"></label>
                            <select asp-for="Tarea.ProyectoId" asp-items="Model.ProyectosLista" class="form-select">
                                <option value="">-- Seleccione un proyecto --</option>
                            </select>
                            <span asp-validation-for="Tarea.ProyectoId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Tarea.NombreTarea" class="form-label"></label>
                            <input asp-for="Tarea.NombreTarea" class="form-control" placeholder="Ej: Diseño de interfaz" />
                            <span asp-validation-for="Tarea.NombreTarea" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Tarea.FechaInicio" class="form-label"></label>
                                <input asp-for="Tarea.FechaInicio" class="form-control" type="date" />
                                <span asp-validation-for="Tarea.FechaInicio" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Tarea.FechaFinalizacion" class="form-label"></label>
                                <input asp-for="Tarea.FechaFinalizacion" class="form-control" type="date" />
                                <span asp-validation-for="Tarea.FechaFinalizacion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Tarea.Integrantes" class="form-label"></label>
                            <input asp-for="Tarea.Integrantes" class="form-control" placeholder="Luis Gabriel, Monserrat Ceron" />
                            <span asp-validation-for="Tarea.Integrantes" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Tarea.Estatus" class="form-label"></label>
                            <select asp-for="Tarea.Estatus" class="form-select">
                                <option value="Pendiente">Pendiente</option>
                                <option value="En Progreso">En Progreso</option>
                                <option value="Completada">Completada</option>
                                <option value="Pausada">Pausada</option>
                                <option value="Cancelada">Cancelada</option>
                            </select>
                            <span asp-validation-for="Tarea.Estatus" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Tarea.Descripcion" class="form-label"></label>
                            <textarea asp-for="Tarea.Descripcion" class="form-control" rows="3"
                                      placeholder="Descripción detallada"></textarea>
                            <span asp-validation-for="Tarea.Descripcion" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Tarea.Acciones" class="form-label"></label>
                            <textarea asp-for="Tarea.Acciones" class="form-control" rows="3"
                                      placeholder="Acciones necesarias"></textarea>
                            <span asp-validation-for="Tarea.Acciones" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-page="Index" class="btn btn-secondary">← Volver</a>
                            <button type="submit" class="btn btn-success">💾 Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}