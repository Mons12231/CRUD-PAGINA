@page
@model CrudRazorApp.Pages.Tareas.DeleteModel
@{
    ViewData["Title"] = "Eliminar Tarea";
}
<link rel="stylesheet" href="~/css/IndexTareas.css" />

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h2 class="mb-0">🗑️ Eliminar Tarea</h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <strong>⚠️ Advertencia:</strong> ¿Está seguro de eliminar esta tarea? Esta acción no se puede deshacer.
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Proyecto:</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary fs-6">@Model.Tarea.Proyecto?.NombreProyecto</span>
                        </dd>

                        <dt class="col-sm-4">Nombre de la Tarea:</dt>
                        <dd class="col-sm-8"><strong>@Model.Tarea.NombreTarea</strong></dd>

                        <dt class="col-sm-4">Integrantes:</dt>
                        <dd class="col-sm-8">@Model.Tarea.Integrantes</dd>

                        <dt class="col-sm-4">Estatus:</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">@Model.Tarea.Estatus</span>
                        </dd>

                        <dt class="col-sm-4">Descripción:</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Tarea.Descripcion))
                            {
                                <div class="border p-3 bg-light rounded">@Model.Tarea.Descripcion</div>
                            }
                            else
                            {
                                <span class="text-muted">Sin descripción</span>
                            }
                        </dd>
                    </dl>

                    <form method="post">
                        <input type="hidden" asp-for="Tarea.TareaId" />
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-page="Index" class="btn btn-secondary">← Cancelar</a>
                            <button type="submit" class="btn btn-danger">🗑️ Confirmar Eliminación</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>